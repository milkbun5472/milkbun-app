<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lisa.codex-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/lisa/Library/Application Support/LisaPhone/codex-watchdog/codex_watchdog.py</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/lisa/Library/Application Support/LisaPhone/codex-watchdog/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/lisa/Library/Application Support/LisaPhone/codex-watchdog/launchd.err.log</string>
</dict>
</plist>
