[Unit]
Description=Codex VPS worker supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/services/codex
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/services/codex/bin/codex-worker.sh
Restart=on-failure
RestartSec=2
StandardOutput=append:%h/services/codex/logs/worker.log
StandardError=append:%h/services/codex/logs/worker-error.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/services/codex %h/.codex

[Install]
WantedBy=default.target
