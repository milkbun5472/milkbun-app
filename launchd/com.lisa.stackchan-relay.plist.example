<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lisa.stackchan-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
    <string>/Users/lisa/Desktop/lisa-practice/yanqiu-den/stackchan-relay/server.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/lisa/Desktop/lisa-practice/yanqiu-den/stackchan-relay</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/lisa/Library/Logs/stackchan-relay.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/lisa/Library/Logs/stackchan-relay.err.log</string>
</dict>
</plist>
