<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lisa.stackchan-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>REPLACE_WITH_ABSOLUTE_RELAY_ENTRYPOINT</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_ABSOLUTE_RELAY_DIRECTORY</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>STACKCHAN_ENV_FILE</key>
    <string>REPLACE_WITH_ABSOLUTE_ENV_FILE</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_ABSOLUTE_LOG_DIRECTORY/stackchan-relay.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_ABSOLUTE_LOG_DIRECTORY/stackchan-relay.err.log</string>
</dict>
</plist>

